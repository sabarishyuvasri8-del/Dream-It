# Autopilot Agent - Required Environment Variables
# These must be set in your Supabase Edge Function environment (or locally for testing)

# 1. Gemini API Key (Stage A & Stage B Reasoning)
GEMINI_API_KEY="your_api_key_here"
VITE_GEMINI_API_KEY="your_api_key_here"

# 2. Google Calendar API (Execution)
GOOGLE_CALENDAR_CLIENT_ID="your_client_id_here"
GOOGLE_CALENDAR_CLIENT_SECRET="your_client_secret_here"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/auth/callback"
GOOGLE_CALENDAR_ACCESS_TOKEN="your_test_access_token_for_hackathon"

# 3. Slack Integration (Audit / Notification)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# Note: In a production app, the GCal Token should be acquired via OAuth
# For the hackathon demo, you can inject it directly or use GOOGLE_CALENDAR_ACCESS_TOKEN as a fallback.
