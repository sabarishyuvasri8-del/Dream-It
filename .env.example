# ==========================================
# DREAM-IT ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# 1. Server-Side Keys (Set in Vercel Project Settings / Serverless Environment)
# These are kept strictly secret and never sent to browser clients.
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_optional_groq_api_key_here"

# 2. Client-Side Public Keys
# Vite exposes variables prefixed with VITE_ to the browser bundle.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
VITE_CADENCE_API_URL="http://localhost:8000"
